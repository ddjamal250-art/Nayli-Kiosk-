@echo off
chcp 65001 > nul
title تشغيل العرض التقديمي الاستثماري 10M$ - Nayli Market 3D Keynote
echo ======================================================================
echo    إطلاق العرض التقديمي الاستثماري العالمي لمشروع نايلي ماركت (3D Keynote)
echo ======================================================================
echo.
echo [1/2] فتح العرض التقديمي ثلاثي الأبعاد في المتصفح...
cd /d "%~dp0"
start "" "presentation_3d.html"
echo.
echo [2/2] تم التشغيل بنجاح!
echo ----------------------------------------------------------------------
echo  مفاتيح التحكم أثناء العرض:
echo   • المسافة (Space) أو السهم الأيمن / الأيسر : التنقل بين الشرائح
echo   • مفتاح F : تفعيل / إلغاء ملء الشاشة (Fullscreen)
echo   • مفتاح M : كتم / تفعيل المؤثرات الصوتية المستقبلية
echo   • مفتاح P : تشغيل نمط العرض الذاتي (Autoplay)
echo   • الفأرة (Mouse) : تدوير وتكبير المشهد ثلاثي الأبعاد 360 درجة بحرية
echo ----------------------------------------------------------------------
echo.
timeout /t 5 > nul

